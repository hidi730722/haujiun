PORT=3300
BASE_URL=http://localhost:3300
# 請改成隨機字串（例如用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 產生）
SESSION_SECRET=change-me-to-a-random-string

# 以下 SMTP 設定為選填。未設定時，忘記密碼的重設連結會印在伺服器 console，
# 方便你在還沒申請寄信服務前也能測試完整流程。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="網拍經營系統 <no-reply@example.com>"

# AI 生圖風格庫功能需要 OpenAI API 金鑰(至 platform.openai.com 申請並綁定付款方式)。
# 未設定時，風格庫上傳/瀏覽仍可正常使用，只有「生成」按鈕會顯示提示訊息。
OPENAI_API_KEY=
